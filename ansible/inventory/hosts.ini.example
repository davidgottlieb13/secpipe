[control]
secpipe-control ansible_host=192.168.100.10

[gitlab]
secpipe-gitlab ansible_host=192.168.100.11

[runner]
secpipe-runner ansible_host=192.168.100.12

[k3s_server]
secpipe-k3s-server ansible_host=192.168.100.20

[k3s_agent]
secpipe-k3s-agent ansible_host=192.168.100.21

[vault]
secpipe-vault ansible_host=192.168.100.30

[observability]
secpipe-observability ansible_host=192.168.100.40

[sonarqube]
secpipe-sonarqube ansible_host=192.168.100.50

[all:vars]
ansible_user=ansible
ansible_ssh_private_key_file=/home/ansible/.ssh/secpipe_ansible
