external_url 'http://{{ gitlab_external_ip }}'

# Resource optimization for a 6GB lab VM:
# We run our own dedicated observability stack in Phase 6,
# so GitLab's bundled monitoring is redundant overhead here.
prometheus_monitoring['enable'] = false
#grafana['enable'] = false

# Reduce Puma worker processes (default scales with CPU count,
# which is fine, but we cap memory-hungry workers explicitly)
puma['worker_processes'] = 2

# Reduce Sidekiq concurrency (background job processor)
sidekiq['max_concurrency'] = 10

# Container registry — enabled starting Phase 2, running over HTTP
# (no TLS in this lab; runner is configured with an explicit insecure-registry
# exception rather than exposing this registry outside the isolated lab network)
registry_external_url 'http://{{ gitlab_external_ip }}:5050'
gitlab_rails['registry_enabled'] = true
